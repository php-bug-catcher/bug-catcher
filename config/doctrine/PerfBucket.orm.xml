<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://raw.githubusercontent.com/doctrine/doctrine2/master/doctrine-mapping.xsd">

    <!--
        A time-series table designed as one: BIGINT AUTO_INCREMENT so inserts append to the index,
        no inheritance, no UUID.

        The unique constraint carries idempotency for ingest *and* roll-up - both write through
        INSERT ... ON DUPLICATE KEY UPDATE, so a bucket completed by a later batch lands on the
        same row instead of a second one. `host` is part of it because the collector keys its
        buckets by host as well; without it two vhosts on one machine would collapse into one row
        and the stored host would be whichever arrived first. The path is in there as its hash,
        since a normalised path still runs to a kilobyte.

        Every column of that key stays under 767 bytes, which is the per-column index prefix limit
        of InnoDB before MySQL 5.7 - hence host at 191 characters rather than 255.

        The index serves the dashboard, which always reads one project's buckets of one
        granularity over a window.
    -->
    <entity name="BugCatcher\Entity\PerfBucket" table="perf_bucket"
            repository-class="BugCatcher\Repository\PerfBucketRepository">
        <indexes>
            <index name="perf_window_idx" columns="project_id,granularity,bucket_at"/>
        </indexes>
        <unique-constraints>
            <unique-constraint name="perf_bucket_uniq"
                               columns="granularity,bucket_at,project_id,server_name,host,path_hash"/>
        </unique-constraints>

        <id name="id" type="bigint" column="id">
            <generator strategy="IDENTITY"/>
        </id>

        <field name="granularity" type="string" length="10" nullable="false"
               enum-type="BugCatcher\Enum\PerfGranularity"/>
        <field name="bucketAt" type="datetime_immutable" nullable="false"/>

        <!-- The machine. -->
        <field name="serverName" type="string" length="64" nullable="false"/>
        <!-- The vhost. -->
        <field name="host" type="string" length="191" nullable="false"/>
        <field name="path" type="string" length="1024" nullable="false"/>
        <field name="pathHash" type="string" length="32" nullable="false"/>

        <field name="hits" type="bigint" nullable="false"/>
        <!-- Seconds. -->
        <field name="sumDuration" type="float" nullable="false"/>
        <field name="sumUser" type="float" nullable="false"/>
        <field name="sumSys" type="float" nullable="false"/>
        <field name="maxDuration" type="float" nullable="false"/>
        <!-- Bytes. -->
        <field name="sumMem" type="bigint" nullable="false"/>
        <field name="maxMem" type="bigint" nullable="false"/>
        <field name="clientErrors" type="bigint" nullable="false"/>
        <field name="serverErrors" type="bigint" nullable="false"/>

        <!-- Sixteen columns bin_0 .. bin_15, one per bin of HistogramBins. -->
        <embedded name="durationHistogram" class="BugCatcher\Entity\DurationHistogram"
                  use-column-prefix="false"/>

        <many-to-one field="project" target-entity="BugCatcher\Entity\Project">
            <join-column name="project_id" referenced-column-name="id" on-delete="CASCADE" nullable="false"/>
        </many-to-one>

        <one-to-many field="extra" target-entity="BugCatcher\Entity\PerfBucketExtra" mapped-by="bucket"
                     index-by="name" orphan-removal="true">
            <cascade>
                <cascade-persist/>
                <cascade-remove/>
            </cascade>
        </one-to-many>
    </entity>
</doctrine-mapping>
