<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://raw.githubusercontent.com/doctrine/doctrine2/master/doctrine-mapping.xsd">

    <!--
        Sixteen bins, sixteen BIGINT columns, embedded into perf_bucket as bin_0 .. bin_15.

        Not one JSON column: MySQL before 5.7 has no JSON type, adding to a bin is then plain
        integer arithmetic in the upsert rather than JSON extraction MySQL would do in DOUBLE, and
        a window's percentile is SUM(bin_0), SUM(bin_1), ... in one aggregate query.
    -->
    <embeddable name="BugCatcher\Entity\DurationHistogram">
        <field name="bin0" type="bigint" nullable="false"/>
        <field name="bin1" type="bigint" nullable="false"/>
        <field name="bin2" type="bigint" nullable="false"/>
        <field name="bin3" type="bigint" nullable="false"/>
        <field name="bin4" type="bigint" nullable="false"/>
        <field name="bin5" type="bigint" nullable="false"/>
        <field name="bin6" type="bigint" nullable="false"/>
        <field name="bin7" type="bigint" nullable="false"/>
        <field name="bin8" type="bigint" nullable="false"/>
        <field name="bin9" type="bigint" nullable="false"/>
        <field name="bin10" type="bigint" nullable="false"/>
        <field name="bin11" type="bigint" nullable="false"/>
        <field name="bin12" type="bigint" nullable="false"/>
        <field name="bin13" type="bigint" nullable="false"/>
        <field name="bin14" type="bigint" nullable="false"/>
        <field name="bin15" type="bigint" nullable="false"/>
    </embeddable>
</doctrine-mapping>
