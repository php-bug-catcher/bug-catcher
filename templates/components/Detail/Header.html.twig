<header{{ attributes.defaults({
    class:'pb-1 mb-4 border-bottom d-flex align-items-center'
}) }}>
    <img class="p-1" src="{{ asset('/assets/logo/'~logo~'/icon.svg', 'bug_catcher') }}" alt="bug" style="width: 43px;height:43px;"/>
    <span class="fs-4 text-break">{{ record.requestUri|u.truncate(150, '...') }}</span>
    <span class="d-flex align-items-center gap-1 ms-2 flex-shrink-0">
        <a href="{{ record.requestUri }}" target="_blank" rel="noopener noreferrer"
           class="btn btn-sm btn-link text-body-secondary p-1 lh-1"
           title="{{ 'Open in new tab'|trans({},"BugCatcher") }}"
           aria-label="{{ 'Open in new tab'|trans({},"BugCatcher") }}">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M15 3h6v6"/>
                <path d="M10 14 21 3"/>
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            </svg>
        </a>
        {% include '@BugCatcher/components/_copy_button.html.twig' with {
            text: record.requestUri,
            label: 'Copy URL'|trans({},"BugCatcher"),
        } only %}
    </span>
</header>
