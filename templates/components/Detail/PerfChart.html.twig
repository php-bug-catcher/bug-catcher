{# The route around the time it regressed. The dashed line is what normal was. #}
{% trans_default_domain 'BugCatcher' %}
<div{{ attributes.defaults({class:'px-4 py-3'}) }}>
	{% if this.chart is empty %}
		<p class="text-sm text-muted">
			{{ 'No measurements are kept for this route any more.'|trans }}
		</p>
	{% else %}
		<figure class="bc-chart">
			<figcaption class="flex items-center gap-1 pb-1 text-xs uppercase text-muted">
				{{ 'The regression'|trans }}
				{% include '@BugCatcher/components/_hint.html.twig' with {
					text: 'The metric this record was written for, over the same route, around the window it regressed in. The dashed line is the baseline it was compared against — without it a spike says nothing about whether it was unusual.'|trans
				} only %}
			</figcaption>
			{{ this.chart|raw }}
			<figcaption class="pt-1 text-xs text-muted">
				{{ 'Dashed: the baseline this was measured against (%baseline%).'|trans({
					'%baseline%': this.report.unit.format(this.report.baseline)
				}) }}
			</figcaption>
		</figure>
	{% endif %}
</div>
