{#
	singleOpen replicates Bootstrap's data-bs-parent: opening a frame closes the others.
	Which frame starts open is decided server-side by `opened` and expressed purely through
	aria-expanded - disclosure_controller reads that on connect, so there is no second flag.
#}
<div{{ attributes.defaults({
	class:'px-4 py-3'
}) }} {{ stimulus_controller('disclosure', {singleOpen: true}) }}>
	<div class="divide-y divide-line overflow-hidden rounded-lg border border-line">
		{% for key,item in this.trace %}
			{% set panelId = 'frame-' ~ record.id ~ '-' ~ key %}

			<div>
				<h3 class="flex items-stretch">
					<button type="button"
							data-testid="frame-trigger"
							class="btn btn-ghost flex-1 justify-start rounded-none border-0 text-left font-mono text-xs"
							{{ stimulus_target('disclosure','trigger') }}
							{{ stimulus_action('disclosure','toggle') }}
							aria-expanded="{{ opened == key ? 'true' : 'false' }}"
							aria-controls="{{ panelId }}">
						{{ item.file }} (line {{ item.line }})
						{% if item.frame %}<small class="ml-2 text-muted">{{ item.frame }}</small>{% endif %}
					</button>

					{% if this.copyPath(key) %}
						<span class="flex shrink-0 items-center px-2">
							{% include '@BugCatcher/components/_copy_button.html.twig' with {
								text: this.copyPath(key),
								label: 'Copy path with line'|trans({},"BugCatcher"),
							} only %}
						</span>
					{% endif %}
				</h3>

				<div id="{{ panelId }}" {{ stimulus_target('disclosure','panel') }}
					 class="{{ opened == key ? '' : 'hidden' }} p-2">
					{# The line numbers are CSS counters seeded by this inline counter-set - see
					   .code in app.css. StackTraceTest asserts on it; do not render numbers by hand. #}
					{# `raw` is safe here: CodeHighlighter escapes the source before adding its spans,
					   and it is unit tested for exactly that. #}
					<div class="code">
						{% for lineNum,line in this.code(key) %}
							<code class="{% if item.line == lineNum %}selected{% endif %}"
								  style="counter-set: listing {{ lineNum - 1 }};">{{ line|raw }}</code>
						{% endfor %}
					</div>
				</div>
			</div>
		{% endfor %}
	</div>
</div>
