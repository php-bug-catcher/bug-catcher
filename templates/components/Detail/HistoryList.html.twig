<div{{ attributes.defaults({
	class:'px-4 py-3'
}) }}>
	{% set items = this.history %}
	{% if items|length > 1 %}
		{# The panel id is scoped by record: the detail page renders two disclosures and they
		   used to collide on a shared Bootstrap data-bs-parent id. #}
		{% set panelId = 'history-' ~ record.id %}

		<div {{ stimulus_controller('disclosure') }}>
			<button type="button"
					class="btn btn-sm btn-ghost w-full justify-between"
					{{ stimulus_target('disclosure','trigger') }}
					{{ stimulus_action('disclosure','toggle') }}
					aria-expanded="false"
					aria-controls="{{ panelId }}">
				<span data-testid="history-range" class="font-mono text-xs">
					{{- items[0].date|date('d.m.Y H:i:s') }} - {{ items[items|length-1].date|date('d.m.Y H:i:s') -}}
				</span>
				<span class="text-xs text-muted">({{ items|length }}x)</span>
			</button>

			<div id="{{ panelId }}" {{ stimulus_target('disclosure','panel') }} class="hidden pl-2 pt-3">
				<ul class="timeline space-y-1.5">
					{% for item in items %}
						<li class="timeline-item">
							<p class="mb-0 font-mono text-xs text-muted">
								{{ item.date|date('d.m.Y H:i:s') }}
								{% if item.count > 0 %}<small class="text-accent">({{ item.count }}x)</small>{% endif %}
							</p>
						</li>
					{% endfor %}
				</ul>
			</div>
		</div>
	{% else %}
		<h3 class="font-mono text-sm text-muted">{{ record.date|date("d.m.Y H:i:s") }}</h3>
	{% endif %}
</div>
