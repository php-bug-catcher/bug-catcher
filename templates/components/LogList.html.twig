{#
	The two class names handed to persistent_selection_stimulus_controller are applied to
	the select buttons by that bundle's JavaScript, so they have to be our class names now
	that Bootstrap's are gone.
#}
<div{{ attributes.defaults({
	class:'panel panel-accent p-3'
}).defaults(persistent_selection_stimulus_controller("main_logs", null,{
	selectAllClass:'btn-accent',
	unselectAllClass:'btn-ghost',
},"default",true)) }}>
	{{ this.init }}
	{% set logs = this.logs %}
	{% set isAllSelected = persistent_selection_is_selected_all("main_logs") %}
	{% set isCurrentSelected = true %}
	{% for log in logs %}
		{% set isCurrentSelected = isCurrentSelected and persistent_selection_is_selected("main_logs",log) %}
	{% endfor %}

	{% if logs|length or query is not empty %}
		<div class="flex flex-wrap items-center gap-2 border-b border-line pb-3">
			<button class="btn btn-sm {{ isCurrentSelected ? 'btn-accent' : 'btn-ghost' }}"
					data-action="{{ persistent_selection_stimulus_controller_name }}#selectCurrentPage"
			>
				<twig:ux:icon name="bi:check" width="16" height="16"/>
				{{ 'Select visible'|trans }}
			</button>

			<button class="btn btn-sm {{ isAllSelected ? 'btn-accent' : 'btn-ghost' }}"
					data-action="{{ persistent_selection_stimulus_controller_name }}#selectAll"
			>
				<twig:ux:icon name="bi:check-all" width="16" height="16"/>
				{{ 'Select all'|trans }}
			</button>

			<span class="text-xs tabular-nums text-muted">
				{{ persistent_selection_count("main_logs") }} / {{ persistent_selection_total("main_logs") }}
			</span>

			<input type="search"
				   data-model="query"
				   class="input w-48"
				   placeholder="{{ 'Error code'|trans }}"
				   aria-label="{{ 'Error code'|trans }}"
			>

			<div class="ml-auto flex items-center gap-2">
				{% if app.request.attributes.get("project") is not null %}
					<a href="{{ path('bug_catcher.dashboard.index') }}" class="btn btn-sm btn-ghost">
						<twig:ux:icon name="lucide:filter-x" width="16" height="16"/>
						{{ 'Clear filter'|trans }}
					</a>
				{% endif %}
				<button class="btn btn-sm btn-accent"
						data-action="live#action"
						data-live-action-param="clearAll"
				>
					<twig:ux:icon name="game-icons:magic-broom" width="16" height="16"/>
					{{ 'Fix selected'|trans }}
				</button>
			</div>
		</div>

		<ul class="divide-y divide-line">
			{% for log in logs %}
				{{ component(log.componentName, {log: log, status: status, key:log.id}) }}
			{% endfor %}
		</ul>
	{% else %}
		<div class="flex flex-col items-center gap-3 px-4 py-12 text-center">
			<twig:ux:icon name="lucide:party-popper" width="48" height="48" class="text-ok"/>
			<p class="text-glow font-mono text-sm uppercase tracking-[0.35em] text-ok">
				{{ 'No bugs, hurrah'|trans({},"BugCatcher") }}
			</p>
			<p class="max-w-prose text-sm text-muted">
				{{ this.funnyMessage|trans({},"BugCatcher") }}
			</p>
			<div class="flex flex-wrap justify-center gap-2 pt-1">
				{% if app.request.attributes.get("project") is not null %}
					<a href="{{ path('bug_catcher.dashboard.index') }}" class="btn btn-sm btn-ghost">
						<twig:ux:icon name="lucide:filter-x" width="16" height="16"/>
						{{ 'Clear filter'|trans }}
					</a>
				{% endif %}
				<button type="button" class="btn btn-sm btn-ghost"
						onclick="alert('{{ 'Just funny 🙂'|trans({},"BugCatcher") }}')">
					<twig:ux:icon name="lucide:bug-off" width="16" height="16"/>
					{{ 'Generate bug'|trans({},"BugCatcher") }}
				</button>
			</div>
		</div>
	{% endif %}
</div>
