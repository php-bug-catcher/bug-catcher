{#
	The phptop table. Every control is a writable LiveProp, so `data-model` is the whole of the
	interaction - the server re-reads the report and re-renders the table.
#}
{% trans_default_domain 'BugCatcher' %}
{% set report = this.report %}
{% set unitSuffix = this.perHit ? '/hit' : '' %}

<div{{ attributes.defaults({class:'panel p-3'}) }}>
	<div class="flex flex-wrap items-center gap-2 border-b border-line pb-3">
		<span class="inline-flex items-center gap-1 text-sm font-semibold text-fg">
			{{ 'Heaviest routes'|trans }}{% if this.project is null %} — {{ 'all projects'|trans }}{% endif %}
			{% include '@BugCatcher/components/_hint.html.twig' with {
				text: 'What phptop prints, over the stored buckets: the rows of the window that cost the most. Click a column heading to sort by it, and "Per hit" turns the totals into averages per request — which is how a rarely-called but expensive route shows itself.'|trans
			} only %}
		</span>

		{% include '@BugCatcher/components/_perf_range.html.twig' with {
			range: this.range, windows: this.windows, selected: this.hours
		} only %}

		<select data-model="group" class="input input-sm w-auto" aria-label="{{ 'Group by'|trans }}">
			{% for group in this.groups %}
				<option value="{{ group.value }}" {{ group == this.group ? 'selected' : '' }}>{{ group.label|trans }}</option>
			{% endfor %}
		</select>

		<label class="chip chip-info cursor-pointer">
			<input type="checkbox" data-model="perHit" {{ this.perHit ? 'checked' : '' }} class="mr-1">
			{{ 'Per hit'|trans }}
		</label>

		<span class="ml-auto text-xs tabular-nums text-muted">
			{{ report.window.from|date('d.m. H:i') }} – {{ report.window.to|date('H:i') }}
		</span>
	</div>

	{% if report.isEmpty %}
		<p class="py-6 text-center text-sm text-muted">{{ 'No performance data in this window.'|trans }}</p>
	{% else %}
		<table class="w-full text-sm">
			<thead>
			<tr class="border-b border-line text-left text-xs uppercase text-muted">
				<th class="py-1 pr-2 font-medium">{{ report.group.label|trans }}</th>
				{% for sort in this.sorts %}
					<th class="py-1 pl-2 text-right font-medium">
						{# the header is the sort control: clicking it is the only way to reorder #}
						<button type="button"
								data-model="sort"
								value="{{ sort.value }}"
								data-action="live#update"
								class="{{ sort == this.sort ? 'text-accent' : 'hover:text-fg' }}"
						>{{ sort.label|trans }}</button>
					</th>
				{% endfor %}
			</tr>
			</thead>
			<tbody>
			{% for row in report.rows %}
				{#
					The id is what a regression's link scrolls to, and only exists when the rows are
					routes: grouped by machine or vhost the label is not a path and the fragment
					would point at the wrong kind of thing. Both class names are written out in full
					or Tailwind would not find them in the build.
				#}
				<tr class="border-b border-line/40 last:border-0 {{ this.isHighlighted(row) ? 'bg-accent/10 ring-1 ring-accent/40' : 'hover:bg-surface-2/60' }}"
					{% if this.groupedByPath %}id="perf-path-{{ row.anchor }}"{% endif %}
				>
					<td class="w-2/5 py-1 pr-2" title="{{ row.label }}">
						<span class="block truncate font-mono">{{ row.label }}</span>
					</td>
					<td class="py-1 pl-2 text-right tabular-nums">{{ row.hits }}</td>
					<td class="py-1 pl-2 text-right tabular-nums">{{ (this.perHit ? row.msPerHit : row.totalMs)|round(1) }} ms{{ unitSuffix }}</td>
					<td class="py-1 pl-2 text-right tabular-nums">{{ (this.perHit ? row.userMsPerHit : row.userMs)|round(1) }} ms</td>
					<td class="py-1 pl-2 text-right tabular-nums">{{ (this.perHit ? row.sysMsPerHit : row.sysMs)|round(1) }} ms</td>
					<td class="py-1 pl-2 text-right tabular-nums">{{ (row.memPerHit / 1048576)|round(1) }} MiB</td>
					<td class="py-1 pl-2 text-right tabular-nums">{{ (row.maxMem / 1048576)|round(1) }} MiB</td>
					{#
						The slowest single run, which is the only column that can describe one past
						the histogram's top bin: p95 saturates at 60000 ms because nothing bounds
						that bin from above. An eighteen-minute cron job reads 60000 there and
						1081002 here.
					#}
					<td class="py-1 pl-2 text-right tabular-nums">{{ row.maxMs|round(1) }} ms</td>
					<td class="py-1 pl-2 text-right tabular-nums">
						{{ row.p95Ms is null ? '–' : (row.p95Ms|round(1) ~ ' ms') }}
					</td>
				</tr>
			{% endfor %}
			</tbody>
		</table>

		{% if report.truncated %}
			{#
				A table that silently shows the top of a list it cut off reads as the whole list.
				The cut is made by the column being sorted on, so the message names it - except
				for p95, which no query can order by, where the window really is cut to its
				busiest rows first.
			#}
			<p class="pt-2 text-xs text-muted">
				{% if report.sort.orderBy is null %}
					{{ 'Showing the %limit% busiest rows of the window.'|trans({'%limit%': this.limit}) }}
				{% else %}
					{{ 'Showing the %limit% heaviest rows of the window by %sort%.'|trans({'%limit%': this.limit, '%sort%': report.sort.label|trans}) }}
				{% endif %}
			</p>
		{% endif %}

		{#
			The link that opened this page points a fragment at a row. When the row is not here the
			page would simply not scroll, which reads as a broken link rather than as the fact it
			is: a route slow enough to regress is often not a route called often enough to be heavy.
		#}
		{% if this.path and not this.isPathListed %}
			<p class="pt-2 text-xs text-muted">
				{{ '%path% is not among the busiest rows of this window — the charts above are still its own.'|trans({'%path%': this.path}) }}
			</p>
		{% endif %}
	{% endif %}
</div>
