{#
	Standalone login page - it used to extend EasyAdmin's login_minimal, which dragged in
	EasyAdmin's Bootstrap CSS just for this one screen.

	The field names are what the firewall reads (see config/recipes/packages/security.yaml,
	which relies on Symfony's form_login defaults). They keep their |default() fallbacks so an
	application that overrides username_parameter and friends can still pass them in.
#}
{% extends '@BugCatcher/base.html.twig' %}

{% block title %}{{ 'Log in'|trans({},'BugCatcher') }} · {{ app_name|default('Bug Catcher') }}{% endblock %}

{# no nav bar: there is nothing to navigate to before logging in #}
{% block nav %}{% endblock %}

{% block body %}
	<main class="flex min-h-screen items-center justify-center px-4 py-12">
		<div class="panel panel-glow panel-accent w-full max-w-sm p-6">
			<img src="{{ logo_url }}" alt="{{ app_name|default('Bug Catcher') }}" class="mx-auto mb-6 h-20 w-auto">

			{% if error|default(false) %}
				<div class="mb-4 rounded-lg border border-danger/40 bg-danger/10 px-3 py-2 text-sm text-danger"
					 role="alert">
					{{ error.messageKey|trans(error.messageData, 'security') }}
				</div>
			{% endif %}

			<form method="post" action="{{ action|default('') }}" class="space-y-4">
				{% if csrf_token_intention|default(false) %}
					<input type="hidden" name="_csrf_token" value="{{ csrf_token(csrf_token_intention) }}">
				{% endif %}

				<input type="hidden" name="{{ target_path_parameter|default('_target_path') }}"
					   value="{{ target_path|default('/') }}">

				<div>
					<label class="mb-1 block text-sm font-medium" for="username">
						{{ 'Your email address'|trans({},'BugCatcher') }}
					</label>
					<input type="text" id="username" class="input"
						   name="{{ username_parameter|default('_username') }}"
						   value="{{ last_username|default('') }}"
						   required autofocus autocomplete="username">
				</div>

				<div>
					<label class="mb-1 block text-sm font-medium" for="password">
						{{ 'Your password'|trans({},'BugCatcher') }}
					</label>
					<input type="password" id="password" class="input"
						   name="{{ password_parameter|default('_password') }}"
						   required autocomplete="current-password">
				</div>

				{% if remember_me_enabled|default(false) %}
					<label class="flex items-center gap-2 text-sm text-muted">
						<input type="checkbox" class="size-4"
							   name="{{ remember_me_parameter|default('_remember_me') }}"
							   {{ remember_me_checked|default(false) ? 'checked' }}>
						{{ 'Remember me'|trans({},'BugCatcher') }}
					</label>
				{% endif %}

				<button type="submit" class="btn btn-accent w-full">
					{{ 'Log in'|trans({},'BugCatcher') }}
				</button>
			</form>
		</div>
	</main>
{% endblock %}
