{#
	Always this bundle's own layout, never EasyAdmin's.

	This used to be `ea is defined ? '@BugCatcher/admin/layout.html.twig' : ...`, which could
	never pick the right branch: EasyAdmin registers `ea` as a Twig *global*, so `ea is defined`
	is always true, and `ea()` returns null outside an admin request. This route lives at
	/change-password - outside ^/admin, so there is no AdminContext - and the EasyAdmin layout
	opens with `ea.i18n.translationDomain`. The page returned a 500 either way.
#}
{% extends '@BugCatcher/base.html.twig' %}

{% block title %}{{ 'Change password'|trans({},'BugCatcher') }} · {{ app_name|default('Bug Catcher') }}{% endblock %}

{% block main %}
	{# Applied here rather than through twig.form_themes: a bundle has no business dictating the
	   host application's global form theme, and the recipe's value is only copied on install, so
	   an existing install would keep rendering this one form with Bootstrap classes. #}
	{% form_theme form '@BugCatcher/form/tailwind_layout.html.twig' %}

	<div class="panel panel-accent mx-auto w-full max-w-md p-6">
		<h1 class="mb-4 text-lg font-semibold">{{ 'Change password'|trans({},'BugCatcher') }}</h1>
		{{ form(form) }}
	</div>
{% endblock main %}
