<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
	<meta charset="UTF-8">
	<meta content="width=device-width, initial-scale=1" name="viewport">
	<title>{% block title %}{{ app_name|default('Bug Catcher') }}{% endblock %}</title>

	{# Applies the stored theme before the stylesheet is parsed, so there is no flash of the
	   wrong theme. Deliberately tiny and inline: anything loaded as a module would run too late.
	   Reacting to later changes is appearance_controller's job, not this script's. #}
	<script>
		(function () {
			var choice = 'auto';
			try {
				choice = localStorage.getItem('bc-theme') || 'auto';
			} catch (e) {
				// storage blocked (private mode, strict cookie policy) - follow the OS instead
			}
			var dark = choice === 'auto'
				? window.matchMedia('(prefers-color-scheme: dark)').matches
				: choice === 'dark';
			document.documentElement.dataset.theme = dark ? 'dark' : 'light';
		})();
	</script>

	<link rel="icon" type="image/svg+xml" href="{{ asset('/assets/logo/'~logo~'/icon.svg','bug_catcher') }}">
	<link rel="icon" type="image/png" href="{{ asset('/assets/logo/'~logo~'/icon.png','bug_catcher') }}">

	{% block stylesheets %}
		{{ encore_entry_link_tags('bug_catcher',null,'bug_catcher') }}
	{% endblock %}

	{% block javascripts %}
		{{ encore_entry_script_tags('bug_catcher',null,'bug_catcher') }}
	{% endblock %}
</head>
<body class="grid-bg min-h-screen bg-bg font-display text-fg antialiased"
	  {{ stimulus_controller('toast') }}
	  {{ stimulus_action('toast','show','toast:show') }}
>

<div {{ stimulus_target('toast','container') }}
	 {# clears the sticky header, so a toast never covers the nav controls #}
	 class="pointer-events-none fixed right-4 top-16 z-50 flex flex-col items-end gap-2"
	 aria-live="polite"
></div>

{% block nav %}
	{% set currentStatus = app.request.attributes.get('status') %}
	{% set statusFilters = [
		{ status: 'new',      label: 'New logs'|trans({},'BugCatcher'),      icon: 'lucide:bug' },
		{ status: 'withheld', label: 'Withheld logs'|trans({},'BugCatcher'), icon: 'lucide:hourglass' },
		{ status: 'archived', label: 'Archived logs'|trans({},'BugCatcher'), icon: 'clarity:archive-line' },
	] %}

	<header class="sticky top-0 z-40 border-b border-line bg-surface/75 backdrop-blur">
		<div class="mx-auto flex max-w-[110rem] flex-wrap items-center gap-x-4 gap-y-2 px-3 py-1.5">
			<a href="{{ path('bug_catcher.dashboard.index') }}" class="flex items-center gap-2">
				<img src="{{ asset('/assets/logo/'~logo~'/icon.svg','bug_catcher') }}" alt=""
					 width="32" height="32" class="size-8">
				<span class="text-glow text-lg font-semibold uppercase tracking-[0.2em] text-accent">
					{{ app_name|default('Bug Catcher') }}
				</span>
			</a>

			<nav class="flex items-center gap-1" aria-label="{{ 'Status'|trans({},'BugCatcher') }}">
				{% for filter in statusFilters %}
					<a href="{{ path('bug_catcher.dashboard.index',{status: filter.status}) }}"
					   class="btn btn-sm {{ currentStatus == filter.status ? 'btn-accent' : 'btn-ghost' }}"
					   {{ currentStatus == filter.status ? 'aria-current="page"' : '' }}
					>
						<twig:ux:icon name="{{ filter.icon }}" width="16" height="16"/>
						<span class="hidden sm:inline">{{ filter.label }}</span>
					</a>
				{% endfor %}
			</nav>

			<div class="ml-auto flex items-center gap-2">
				<div class="flex items-center gap-1 rounded-lg border border-line p-0.5"
					 {{ stimulus_controller('appearance') }}
					 role="group" aria-label="{{ 'Theme'|trans({},'BugCatcher') }}">
					{% for choice in [
						{ value: 'light', label: 'Light'|trans({},'BugCatcher'), icon: 'lucide:sun' },
						{ value: 'dark',  label: 'Dark'|trans({},'BugCatcher'),  icon: 'lucide:moon' },
						{ value: 'auto',  label: 'Auto'|trans({},'BugCatcher'),  icon: 'lucide:monitor' },
					] %}
						<button type="button" class="btn btn-sm btn-icon btn-ghost"
								{{ stimulus_target('appearance','option') }}
								{{ stimulus_action('appearance','select') }}
								data-appearance-choice-param="{{ choice.value }}"
								title="{{ choice.label }}" aria-label="{{ choice.label }}"
								aria-pressed="false">
							<twig:ux:icon name="{{ choice.icon }}" width="16" height="16"/>
						</button>
					{% endfor %}
				</div>

				<div class="relative" {{ stimulus_controller('dropdown') }}>
					<button type="button" class="btn btn-sm btn-ghost"
							{{ stimulus_target('dropdown','trigger') }}
							{{ stimulus_action('dropdown','toggle') }}
							aria-expanded="false" aria-haspopup="true"
							aria-label="{{ 'Menu'|trans({},'BugCatcher') }}">
						<twig:ux:icon name="lucide:user" width="16" height="16"/>
						<twig:ux:icon name="lucide:chevron-down" width="14" height="14"/>
					</button>

					<div {{ stimulus_target('dropdown','menu') }}
						 class="panel panel-glow absolute right-0 z-50 mt-1 hidden w-56 overflow-hidden p-1">
						{% if is_granted('ROLE_ADMIN') %}
							<a href="{{ path('bug_catcher.admin') }}" class="btn btn-sm btn-ghost w-full justify-start">
								<twig:ux:icon name="lucide:settings" width="16" height="16"/>
								{{ 'Administration'|trans({},'BugCatcher') }}
							</a>
						{% endif %}
						<a href="{{ path('bug_catcher.security.change-password') }}"
						   class="btn btn-sm btn-ghost w-full justify-start">
							<twig:ux:icon name="lucide:key-round" width="16" height="16"/>
							{{ 'Change password'|trans({},'BugCatcher') }}
						</a>
						<hr class="my-1 border-line">
						<a href="{{ path('bug_catcher.security.logout') }}"
						   class="btn btn-sm btn-ghost btn-danger w-full justify-start">
							<twig:ux:icon name="lucide:log-out" width="16" height="16"/>
							{{ 'Log out'|trans({},'BugCatcher') }}
						</a>
					</div>
				</div>
			</div>
		</div>
	</header>
{% endblock %}

{% block flashes %}
	{% set flashes = app.flashes %}
	{% if flashes|length %}
		{% set flashStyles = {
			'success': 'border-ok/40 bg-ok/10 text-ok',
			'info':    'border-accent/40 bg-accent/10 text-accent',
			'warning': 'border-warn/40 bg-warn/10 text-warn',
			'danger':  'border-danger/40 bg-danger/10 text-danger',
			'error':   'border-danger/40 bg-danger/10 text-danger',
		} %}
		<div class="mx-auto flex max-w-[110rem] flex-col gap-2 px-3 pt-3">
			{% for type, messages in flashes %}
				{% for message in messages %}
					<div class="rounded-lg border px-4 py-2 text-sm {{ flashStyles[type]|default(flashStyles.info) }}"
						 role="alert">{{ message|raw }}</div>
				{% endfor %}
			{% endfor %}
		</div>
	{% endif %}
{% endblock %}

{% block body %}
	<main class="mx-auto max-w-[110rem] space-y-3 px-3 py-3">
		{% block main %}{% endblock %}
	</main>
{% endblock %}

</body>
</html>
